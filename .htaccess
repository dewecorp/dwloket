# Disable directory browsing; -MultiViews hindari konflik dengan URL tanpa ekstensi
Options -Indexes -MultiViews

DirectoryIndex index.php

# Protect sensitive files
<FilesMatch "^\.|\.(sql|zip|bak|git|env|log|ini)$|composer\.(json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Tanpa RewriteBase: cocok untuk virtual host (dwloket_ok.test) dan localhost/dwloket_ok.

    # GET .../index.php -> .../ (path dari baris permintaan, bukan RewriteBase)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*)index\.php(\?[^\s]*)?\sHTTP [NC]
    RewriteRule .* /%1 [R=301,L,NE]

    # GET .../file.php -> .../file (bukan index.php; itu aturan di atas)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_URI} !index\.php(\?|$)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^\s?]+)\.php(\?[^\s]*)?\sHTTP [NC]
    RewriteRule .* /%1 [R=301,L,NE]

    # Path "folder/namafile" sama dengan nama folder: Apache sering anggap -d di segmen
    # pertama sehingga aturan generik di bawah tidak jalan. Paksa ke file .php.
    RewriteRule ^pelanggan/?$ pelanggan/pelanggan.php [L]
    RewriteRule ^pelanggan/pelanggan/?$ pelanggan/pelanggan.php [L]
    RewriteRule ^saldo/?$ saldo/saldo.php [L]
    RewriteRule ^saldo/saldo/?$ saldo/saldo.php [L]
    RewriteRule ^transaksi/?$ transaksi/transaksi.php [L]
    RewriteRule ^transaksi/transaksi/?$ transaksi/transaksi.php [L]
    RewriteRule ^user/?$ user/user.php [L]
    RewriteRule ^user/user/?$ user/user.php [L]

    # URL tanpa .php -> file .php jika ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Optional: Force HTTPS (uncomment if SSL is installed)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
